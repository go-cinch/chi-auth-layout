#!/bin/sh

set -eu

project_dir='{{ .Project }}'
binary_name='{{ .Computed.service_name_kebab }}'

cd "$project_dir"

# Overwriting a generated project retains files absent from the template.
# Remove the retired capability before module discovery and compilation.
rm -rf './internal/modules/whitelist'

seed_file='./internal/infra/db/migrations/YYYYMMDDHH-02-auth-default-data.sql'
action_seed_file='./internal/infra/db/migrations/YYYYMMDDHH-03-action-default-data.sql'
if [ -f "$seed_file" ]; then
  printf '\nRandomizing default seed codes...\n'
  go run ./internal/cmd/seedcode -file "$seed_file" -file "$action_seed_file"
  rm -r './internal/cmd/seedcode'
fi

if [ -d './internal/infra/db/migrations' ]; then
  timestamp=$(date +"%Y%m%d%H")
  for file in ./internal/infra/db/migrations/YYYYMMDDHH-*; do
    [ -f "$file" ] || continue
    base=$(basename "$file")
    target="./internal/infra/db/migrations/$timestamp-${base#YYYYMMDDHH-}"
    mv "$file" "$target"
  done
fi

printf '\nGenerating typed configuration...\n'
make gen

printf '\nFormatting generated project...\n'
gofmt -w .

printf 'Resolving Go modules...\n'
go mod tidy

if [ "${SCAFFOLD_SKIP_TESTS:-false}" = 'true' ]; then
  printf 'Skipping generated tests (SCAFFOLD_SKIP_TESTS=true).\n'
else
  printf 'Running tests...\n'
  go test ./...
fi

printf 'Building %s...\n' "$binary_name"
mkdir -p ./bin
go build -o "./bin/$binary_name" ./cmd/server

printf '\nProject initialized successfully.\n'
